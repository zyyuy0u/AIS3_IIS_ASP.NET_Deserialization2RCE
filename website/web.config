<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configProtectedData>
    <providers>
      <add name="MyProvider"
           type="System.Configuration.RsaProtectedConfigurationProvider,System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
    </providers>
  </configProtectedData>

  <system.web>
    <!--
    ============================================
    INTENTIONAL VULNERABILITY: Hard-coded machineKey
    ============================================
    這個 machineKey 是刻意硬編在這裡的，用於測試 ViewState 反序列化漏洞。
    在生產環境中，machineKey 必須：
    1. 保存在 IIS 設定而不是 web.config
    2. 定期輪換
    3. 不同伺服器使用不同的 key

    攻擊者如果能讀到這個 key（透過 Stage 1 的路徑穿越漏洞），
    就能偽造簽章正確且加密正確的 ViewState，從而達成 RCE。
    ============================================
    -->
    <machineKey validationKey="A1B2C3D4E5F6A7B8C9D0E1F2A3B4C5D6E7F8A9B0C1D2E3F0A1B2C3D4E5F6A7B8C9D0E1F2A3B4C5D6E7F8"
                 decryptionKey="F8A7B6C5D4E3F2A1B0C9D8E7F6A5B4C3D2E1F0A9B8C7D6E5F4A3B2C1D0E9F8"
                 validation="HMACSHA256"
                 decryption="AES" />

    <!--
    ============================================
    ViewState 安全設定（教育目的：故意不夠安全）
    ============================================
    enableViewStateMac="true"    → 啟用 ViewState MAC 簽章（但 attacker 有 key）
    viewStateEncryptionMode="Always" → 總是加密（但 attacker 有 decryption key）

    如果設定了 ViewStateUserKey，會增加 ViewState 的複雜度，但題目要求不設定。
    ============================================
    -->
    <pages enableViewStateMac="true"
           viewStateEncryptionMode="Always" />

    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" />

    <!--
    ============================================
    錯誤頁面設定（不暴露詳細錯誤資訊給 attacker，但本地開發時可改 mode="On"）
    ============================================
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="Error.aspx">
      <error statusCode="404" redirect="NotFound.aspx" />
    </customErrors>
  </system.web>

  <appSettings>
    <!-- 教育用：這個網站沒有實際功能，純粹用於演示 RCE 漏洞 -->
  </appSettings>

  <connectionStrings>
    <!-- 本靶機不使用資料庫，只用於演示序列化漏洞 -->
  </connectionStrings>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />

    <!--
    ============================================
    IIS 處理器對應（ASP.NET 4.8）
    ============================================
    -->
    <handlers>
      <add name="aspx-ISAPI-2.0"
           path="*.aspx"
           verb="*"
           modules="IsapiModule"
           scriptProcessor="%windir%\Microsoft.NET\Framework64\v4.0.30319\aspnet_isapi.dll"
           preCondition="classicMode,runtimeVersionv4.0,bitness64"
           responseBufferLimit="0" />
    </handlers>

    <!--
    ============================================
    安全相關設定
    ============================================
    移除 Server 標頭，避免暴露伺服器版本。
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="Server" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>

    <!--
    ============================================
    檔案要求設定
    ============================================
    允許存取 ASPX 和其他必要檔案。
    -->
    <security>
      <requestFiltering>
        <!-- 不要太激進地過濾 file= 參數，以保留 LFI 漏洞用於教育 -->
      </requestFiltering>
    </security>
  </system.webServer>

  <!--
  ============================================
  運行期設定（Runtime）
  ============================================
  允許無序 XML，支援序列化。
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web" publicKeyToken="b03f5f7f11d50a3a" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
